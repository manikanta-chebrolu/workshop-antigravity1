# =========================================================================
# BACKEND ENVIRONMENT CONFIGURATION (PRIVATE / SECRETS)
# =========================================================================

# Server Networking
PORT=3000
NODE_ENV=development

# 🟢 Supabase Cloud Database Configuration
# Obtain from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# 🔌 Direct Database Connection String (Used for automated 'npm run db:migrate')
# Obtain from: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres

# 🌟 Google Gemini AI Configuration (Primary Engine)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
