# =========================================================================
# FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to 'frontend/.env' and fill in your values.
# =========================================================================

# Backend API Endpoint
PUBLIC_API_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000

# 🟢 Supabase Public Client Credentials (Anon Key only)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Client Application Metadata & Preferences
VITE_APP_TITLE="Nexus AI Studio"
VITE_APP_VERSION="3.8"
VITE_DEFAULT_THEME="dark"
